# ============================================================================
# Polo Sanca — Production Environment Variables
# Copy to deploy/.env.prod (never commit deploy/.env.prod!)
# ============================================================================

# Domains
API_DOMAIN=api.polosanca.com
FRONTEND_URL=https://app.polosanca.com
CORS_ORIGINS=https://app.polosanca.com

# Flask & JWT Secrets (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_STRONG_JWT_SECRET_KEY

# PostgreSQL / TimescaleDB
POSTGRES_DB=polosanca
POSTGRES_USER=polosanca
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Email (Amazon SES SMTP recommended)
MAIL_SERVER=email-smtp.sa-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=CHANGE_ME_SES_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SES_SMTP_PASS
MAIL_DEFAULT_SENDER=noreply@polosanca.com

# Optional S3 bucket for automated nightly pg_dump backups
# BACKUP_S3_URI=s3://polosanca-db-backups/prod
